# ===== AI 平台每日自动签到 配置示例（复制为 .env，勿提交真实值）=====

# 每日签到触发时间 HH:MM（北京时间；Qoder 活动 10:00 开放，建议 10:05 之后）
CHECKIN_TIME=10:05

# 失败/拥挤重试次数（指数退避 10s/20s/40s）
RETRY_TIMES=3

# 企业微信群机器人 Webhook（群设置 → 群机器人 → 添加，留空则不推送）
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=你的KEY

# 数据目录（容器内固定 /data，compose 已挂载 ./data）
DATA_DIR=/data

# 浏览器登录（容器内 login 子命令 / PC 端 --headful）
BROWSER_HEADLESS=1
# 登录等待超时（秒）
LOGIN_TIMEOUT=300
