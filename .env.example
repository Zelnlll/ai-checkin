# ===== AI 平台每日自动签到 配置示例（复制为 .env，勿提交真实值）=====

# 每日签到触发时间 HH:MM（北京时间；Qoder 活动 10:00 开放，建议 10:05 之后）
CHECKIN_TIME=10:05

# 失败/拥挤重试次数（指数退避 10s/20s/40s）
RETRY_TIMES=3
# 余额循环刷新间隔（分钟，0=关闭；只读接口兼作保活）
BALANCE_REFRESH_MINUTES=60

# ===== 通知通道（二选一；应用通道配置齐全时优先）=====
# 方式一：群机器人 Webhook（群设置 → 群机器人 → 添加）
WECOM_WEBHOOK=

# 方式二：自建应用（管理后台 → 应用管理 → 自建 → 详情页取 AgentId/Secret；corpid 在"我的企业"底部）
# WECOM_CORP_ID=ww开头的企业ID
# WECOM_CORP_SECRET=应用的Secret
# WECOM_AGENT_ID=1000002
# 接收目标二选一：成员userid（通讯录可查，多个用|分隔）或应用会话群chatid
# WECOM_TO_USER=你的userid
# WECOM_CHAT_ID=
# 可选：企微API代理（自建反代如 ddsderek/wxchat），留空走官方地址
# WECOM_API_BASE=http://VPS_IP:52000/cgi-bin


# 数据目录（容器内固定 /data，compose 已挂载 ./data）
DATA_DIR=/data

# 浏览器登录（容器内 login 子命令 / PC 端 --headful）
BROWSER_HEADLESS=1
# 登录等待超时（秒）
LOGIN_TIMEOUT=300

# 面板端口（与守护同进程，默认 8000；改端口需同步 ports 映射）
PANEL_PORT=8000
